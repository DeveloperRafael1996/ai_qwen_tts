# Path to a local Qwen3-TTS-12Hz-1.7B-VoiceDesign snapshot.
# If this path does not exist (or is empty), the app falls back to
# downloading/using "Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign" from the
# Hugging Face Hub (cached locally by huggingface_hub after the first run).
QWEN_TTS_MODEL_PATH=./models/Qwen3-TTS-12Hz-1.7B-VoiceDesign

# Gradio server bind address and port.
PLAYGROUND_HOST=127.0.0.1
PLAYGROUND_PORT=7860

# Directory where generated WAV files are written.
OUTPUT_DIR=outputs
