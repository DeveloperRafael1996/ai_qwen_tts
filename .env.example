# Path to a local Qwen3-TTS-12Hz-1.7B-VoiceDesign snapshot.
# If this path does not exist (or is empty), the app falls back to
# downloading/using "Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign" from the
# Hugging Face Hub (cached locally by huggingface_hub after the first run).
QWEN_TTS_MODEL_PATH=./models/Qwen3-TTS-12Hz-1.7B-VoiceDesign

# Path to a local Qwen3-TTS-12Hz-0.6B-Base (voice cloning) snapshot, used by
# the "Voice Clone" tab. Same local-first / HF Hub fallback behavior as
# above. This model is loaded lazily on first use of that tab, not at
# startup, so a small GPU that can't hold both models at once still works.
QWEN_TTS_VOICE_CLONE_MODEL_PATH=./models/Qwen3-TTS-12Hz-0.6B-Base

# Path to a local Qwen3-TTS-12Hz-0.6B-CustomVoice snapshot, used by the
# "Custom Voice" tab (9 predefined premium speakers). Same local-first /
# HF Hub fallback behavior, and also loaded lazily on first use of that tab.
QWEN_TTS_CUSTOM_VOICE_MODEL_PATH=./models/Qwen3-TTS-12Hz-0.6B-CustomVoice

# Gradio server bind address and port.
PLAYGROUND_HOST=127.0.0.1
PLAYGROUND_PORT=7860

# Directory where generated WAV files are written.
OUTPUT_DIR=outputs
